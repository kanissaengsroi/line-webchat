# Copy to .env.local and fill in. Never commit real values (the repo is public).
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Signs the login cookie. Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# LINE Developers console → your Messaging API channel
#   Basic settings → Channel secret
LINE_CHANNEL_SECRET=
#   Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# Add-friend link shown in the empty inbox, e.g. https://line.me/R/ti/p/@123abcde
NEXT_PUBLIC_LINE_OA_URL=

# Usernames allowed to open the staff inbox, comma separated (e.g. admin,agent1,agent2).
# Required in production; any other username signs in as a customer.
STAFF_USERNAMES=
# true = staff replies in LINE start with the agent's name ("agent1: ...").
NEXT_PUBLIC_SHOW_AGENT_NAME=

# LINE Login channel (optional): enables "Log in with LINE" for customers, together with NEXT_PUBLIC_LIFF_ID.
# Create it under the SAME provider as the Messaging API channel so user IDs match.
LINE_LOGIN_CHANNEL_ID=
# Optional: lets sign-out revoke the LINE token.
LINE_LOGIN_CHANNEL_SECRET=

# Upstash Redis (Vercel Marketplace adds KV_REST_API_URL / KV_REST_API_TOKEN, also accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pusher Channels → App Keys
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# LIFF app (on the LINE Login channel) with chat_message.write scope, endpoint https://<your-app>/liff.
# Inside LINE, customer messages are sent as the user into their LINE chat with the OA.
NEXT_PUBLIC_LIFF_ID=
