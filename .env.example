# Copy to .env.local and fill in. Never commit real values (the repo is public).
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Signs the login cookie. Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# LINE Developers console → your Messaging API channel
#   Basic settings → Channel secret
LINE_CHANNEL_SECRET=
#   Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# Add-friend link shown in the empty inbox, e.g. https://line.me/R/ti/p/@123abcde
NEXT_PUBLIC_LINE_OA_URL=

# Upstash Redis (Vercel Marketplace adds KV_REST_API_URL / KV_REST_API_TOKEN, also accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pusher Channels → App Keys
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
